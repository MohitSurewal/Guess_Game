import random

n = random.randint(1, 100) 
a = -1
guesses = 1

while (a != n):
    
    a = int(input("Enter your Number: "))
    if ( a >n):
        print("Lower Number please: ")
        guesses += 1
        
    elif (a<n):
        print("Higher Number Please: ")
        
        guesses += 1
        
print(f"You have the guess the  Number {n} correctly in {guesses} guesses attempts")
    
